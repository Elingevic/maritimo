---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES } from '../config';
import { getArticulos } from '../lib/utils';

const all = await getArticulos();
---
<Base title="Todas las publicaciones" description="Todas las guías, recursos, artículos y novedades de Rumbo Mercante.">
  <PageHero
    kicker="Bitácora"
    title="Todas las publicaciones"
    lead="Guías, recursos, artículos y novedades, de la más reciente a la más antigua."
    icon="book"
    breadcrumbs={[{ href: '/publicaciones/', label: 'Publicaciones' }]}
  />
  <section class="section-tight list">
    <div class="container">
      <div class="filters" role="group" aria-label="Filtrar por sección">
        <button class="chip is-active" data-filter="all">Todo <span>{all.length}</span></button>
        {CATEGORIES.map((c) => (
          <button class="chip" data-filter={c.id}>
            {c.short} <span>{all.filter((a) => a.data.category === c.id).length}</span>
          </button>
        ))}
      </div>
      <div class="grid grid-3">
        {all.map((a) => (
          <div class="item" data-cat={a.data.category}>
            <ArticleCard article={a} />
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLElement>('.item');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      const f = chip.dataset.filter;
      items.forEach((it) => (it.hidden = f !== 'all' && it.dataset.cat !== f));
    }),
  );
</script>

<style>
  .list {
    padding-bottom: 6rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .chip {
    font: 500 0.9rem/1 var(--font-body);
    padding: 0.6rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink-soft);
    cursor: pointer;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }
  .chip span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .chip.is-active {
    background: var(--navy-800);
    border-color: var(--navy-800);
    color: var(--white);
  }
  .chip.is-active span {
    color: var(--brass-light);
  }
  .item[hidden] {
    display: none;
  }
</style>
