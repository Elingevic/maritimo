---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';

const DAYS = 7;
const hours = Array.from({ length: 24 }, (_, h) => String(h).padStart(2, '0'));
---
<Base
  title="Calculadora de horas de descanso STCW / MLC"
  description="Marca tus horas de trabajo en una semana y comprueba si cumples los mínimos de descanso del Convenio STCW (Regla VIII/1) y el MLC 2006."
>
  <PageHero
    kicker="Herramienta · STCW A-VIII/1 · MLC 2006 Norma A2.3"
    title="Calculadora de horas de descanso"
    lead="Pinta tus horas de trabajo durante 7 días y comprueba al instante si cumples los mínimos de descanso. Funciona en tu navegador: no se envía ningún dato."
    icon="clock"
    accent="var(--c-recursos)"
    breadcrumbs={[{ href: '/recursos/', label: 'Recursos' }, { href: '/recursos/herramientas/', label: 'Herramientas' }, { href: '/recursos/herramientas/calculadora-descanso/', label: 'Calculadora de descanso' }]}
  />

  <section class="section-tight">
    <div class="container">
      <div class="rules">
        <div class="rule"><strong>10 h</strong><span>de descanso mínimo en cualquier periodo de 24 h</span></div>
        <div class="rule"><strong>77 h</strong><span>de descanso mínimo en cualquier periodo de 7 días</span></div>
        <div class="rule"><strong>2</strong><span>periodos de descanso como máximo, uno de ellos de al menos 6 h</span></div>
        <div class="rule"><strong>14 h</strong><span>de intervalo máximo entre periodos de descanso consecutivos</span></div>
      </div>

      <div class="toolbar no-print">
        <div class="presets">
          <span class="label">Aplicar a todos los días:</span>
          <button class="chip" data-preset="g00">Guardia 00–04 / 12–16</button>
          <button class="chip" data-preset="g04">Guardia 04–08 / 16–20</button>
          <button class="chip" data-preset="g08">Guardia 08–12 / 20–24</button>
          <button class="chip" data-preset="dia">Jornada 08–12 / 13–17</button>
        </div>
        <div class="actions">
          <button class="btn btn-ghost btn-sm" id="csv"><Icon name="download" size={16} /> Exportar CSV</button>
          <button class="btn btn-ghost btn-sm" id="clear"><Icon name="close" size={16} /> Vaciar</button>
        </div>
      </div>

      <div class="hint">
        <span class="legend"><span class="sw sw-work"></span> Trabajo <span class="sw sw-rest"></span> Descanso</span>
        <span>
          Haz clic o arrastra sobre las casillas (cada una equivale a 30 minutos). En el móvil, toca cada casilla y
          desliza la cuadrícula para ver todo el día. Tus datos se guardan en este dispositivo.
        </span>
      </div>

      <div class="board-wrap">
        <div class="board" id="board" style={`--days: ${DAYS}`}>
          <div class="hrow head">
            <div class="dlabel"></div>
            <div class="cells">
              {hours.map((h) => <span class="hlabel">{h}</span>)}
            </div>
            <div class="dstats head-stats"><span>Trabajo</span><span>Descanso</span><span>Mín. 24 h</span></div>
          </div>
          {Array.from({ length: DAYS }, (_, d) => (
            <div class="hrow" data-day={d}>
              <div class="dlabel">Día {d + 1}</div>
              <div class="cells">
                {Array.from({ length: 48 }, (_, s) => (
                  <button
                    class="cell"
                    data-i={d * 48 + s}
                    aria-pressed="false"
                    aria-label={`Día ${d + 1}, ${hours[Math.floor(s / 2)]}:${s % 2 ? '30' : '00'}`}
                  />
                ))}
              </div>
              <div class="dstats">
                <span data-k="work">0 h</span>
                <span data-k="rest">24 h</span>
                <span data-k="min">—</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="results" id="results" aria-live="polite">
        <div class="summary">
          <div class="big" id="verdict">
            <span class="badge" id="badge">—</span>
            <div>
              <strong id="verdict-title">Introduce tu horario</strong>
              <span id="verdict-sub">Marca las horas trabajadas en la cuadrícula.</span>
            </div>
          </div>
          <div class="totals">
            <div><span>Trabajo total</span><strong id="t-work">0 h</strong></div>
            <div><span>Descanso total (7 días)</span><strong id="t-rest">168 h</strong></div>
            <div><span>Mínimo en 24 h</span><strong id="t-min">24 h</strong></div>
            <div><span>Máx. trabajo continuo</span><strong id="t-cont">0 h</strong></div>
          </div>
        </div>
        <ul class="issues" id="issues"></ul>
      </div>

      <div class="note note-warn info">
        <Icon name="shield" size={22} />
        <p>
          <strong>Importante:</strong> esta calculadora es orientativa. La Regla VIII/1 del STCW y el MLC 2006 permiten
          excepciones (emergencias, ejercicios, convenios colectivos autorizados por la Administración) y algunos
          Estados de abanderamiento aplican criterios propios. El registro oficial es el que exige tu compañía y tu
          bandera. Se evalúa cualquier periodo de 24 h dentro de los 7 días registrados, también los que cruzan la
          medianoche.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  const DAYS = 7;
  const SLOTS = DAYS * 48;
  const KEY = 'rm-descanso-v1';

  const board = document.getElementById('board')!;
  const cells = Array.from(board.querySelectorAll<HTMLButtonElement>('.cell'));
  let work: boolean[] = new Array(SLOTS).fill(false);

  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (Array.isArray(saved) && saved.length === SLOTS) work = saved.map(Boolean);
  } catch {}

  // ---- Marcado de casillas ----
  // Ratón: clic o arrastrar para pintar varias casillas.
  // Táctil y teclado: cada toque / Enter cambia una casilla (deslizar el dedo desplaza la cuadrícula sin marcar).
  let painting = false;
  let paintValue = true;
  let skipClick = false;
  const setCell = (i: number, v: boolean) => {
    work[i] = v;
    cells[i].classList.toggle('on', v);
    cells[i].setAttribute('aria-pressed', String(v));
  };
  const cellFrom = (e: Event) => (e.target as HTMLElement).closest<HTMLButtonElement>('.cell');

  board.addEventListener('pointerdown', (e) => {
    const t = cellFrom(e);
    if (!t || e.pointerType === 'touch' || e.button !== 0) return;
    e.preventDefault();
    painting = true;
    skipClick = true;
    const i = Number(t.dataset.i);
    paintValue = !work[i];
    setCell(i, paintValue);
    update();
  });
  // Se usa la posición del cursor porque el botón pulsado retiene los eventos del puntero
  window.addEventListener('pointermove', (e) => {
    if (!painting) return;
    const el = document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null;
    const t = el?.closest<HTMLButtonElement>('#board .cell');
    if (!t) return;
    const i = Number(t.dataset.i);
    if (work[i] === paintValue) return;
    setCell(i, paintValue);
    update();
  });
  window.addEventListener('pointerup', () => {
    painting = false;
    // El click posterior al arrastre se ignora; si no llega (soltado fuera de la casilla), se rearma igualmente
    setTimeout(() => (skipClick = false), 0);
  });
  board.addEventListener('click', (e) => {
    const t = cellFrom(e);
    if (!t) return;
    if (skipClick) {
      skipClick = false;
      return;
    }
    const i = Number(t.dataset.i);
    setCell(i, !work[i]);
    update();
  });

  // ---- Presets ----
  const range = (from: number, to: number) => {
    const out: number[] = [];
    for (let h = from * 2; h < to * 2; h++) out.push(h);
    return out;
  };
  const PRESETS: Record<string, number[]> = {
    g00: [...range(0, 4), ...range(12, 16)],
    g04: [...range(4, 8), ...range(16, 20)],
    g08: [...range(8, 12), ...range(20, 24)],
    dia: [...range(8, 12), ...range(13, 17)],
  };
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
    b.addEventListener('click', () => {
      const p = PRESETS[b.dataset.preset!];
      for (let d = 0; d < DAYS; d++) for (let s = 0; s < 48; s++) setCell(d * 48 + s, p.includes(s));
      update();
    }),
  );
  document.getElementById('clear')!.addEventListener('click', () => {
    for (let i = 0; i < SLOTS; i++) setCell(i, false);
    update();
  });
  document.getElementById('csv')!.addEventListener('click', () => {
    const header = ['Dia', ...Array.from({ length: 48 }, (_, s) => `${String(Math.floor(s / 2)).padStart(2, '0')}:${s % 2 ? '30' : '00'}`), 'Horas trabajo', 'Horas descanso'];
    const rows = [header.join(';')];
    for (let d = 0; d < DAYS; d++) {
      const day = work.slice(d * 48, d * 48 + 48);
      const w = day.filter(Boolean).length / 2;
      rows.push([`Dia ${d + 1}`, ...day.map((v) => (v ? 'T' : 'D')), w, 24 - w].join(';'));
    }
    const blob = new Blob(['﻿' + rows.join('\n')], { type: 'text/csv;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'horas-de-descanso.csv';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // ---- Cálculo ----
  const fmt = (slots: number) => {
    const h = slots / 2;
    return Number.isInteger(h) ? `${h} h` : `${Math.floor(h)} h 30 min`;
  };

  // Formato compacto para la tabla (evita saltos de línea que moverían la cuadrícula)
  const fmtShort = (slots: number) => `${(slots / 2).toLocaleString('es-ES')} h`;

  type Period = { start: number; end: number }; // [start, end)
  function restPeriods(): Period[] {
    const out: Period[] = [];
    let i = 0;
    while (i < SLOTS) {
      if (!work[i]) {
        const s = i;
        while (i < SLOTS && !work[i]) i++;
        out.push({ start: s, end: i });
      } else i++;
    }
    return out;
  }

  function update() {
    localStorage.setItem(KEY, JSON.stringify(work.map((v) => (v ? 1 : 0))));
    const issues: { day: number | null; text: string }[] = [];
    const totalWork = work.filter(Boolean).length;
    const anyWork = totalWork > 0;

    // Mínimo de descanso en ventanas móviles de 24 h
    const restIn = (from: number) => {
      let r = 0;
      for (let i = from; i < from + 48; i++) if (!work[i]) r++;
      return r;
    };
    const dayMin: number[] = [];
    let globalMin = 48;
    for (let d = 0; d < DAYS; d++) {
      let m = 48;
      for (let s = 0; s < 48; s++) {
        const i = d * 48 + s;
        if (i + 48 > SLOTS) break;
        m = Math.min(m, restIn(i));
      }
      dayMin.push(m);
      globalMin = Math.min(globalMin, m);
      if (m < 20) issues.push({ day: d, text: `Día ${d + 1}: hay un periodo de 24 h con solo ${fmt(m)} de descanso (mínimo 10 h).` });
    }

    // 77 h en 7 días
    const totalRest = SLOTS - totalWork;
    if (totalRest < 154)
      issues.push({ day: null, text: `Descanso semanal de ${fmt(totalRest)}: por debajo del mínimo de 77 h en 7 días.` });

    // División del descanso: en cualquier periodo de 24 h, las 10 h mínimas deben cubrirse con
    // 2 periodos como máximo, y uno de ellos debe ser de al menos 6 h (directrices OMI/OIT).
    // Solo se evalúa donde ya hay 10 h de descanso; si no, el incumplimiento anterior ya lo indica.
    const periods = restPeriods();
    const flagged = new Set<string>();
    for (let i = 0; i + 48 <= SLOTS; i++) {
      if (restIn(i) < 20) continue;
      const lens = periods
        .map((p) => Math.min(p.end, i + 48) - Math.max(p.start, i))
        .filter((l) => l > 0)
        .sort((x, y) => y - x);
      const d = Math.floor(i / 48);
      if (lens[0] < 12 && !flagged.has(`6-${d}`)) {
        flagged.add(`6-${d}`);
        issues.push({ day: d, text: `Día ${d + 1}: en un periodo de 24 h ningún descanso alcanza las 6 h continuas.` });
      } else if (lens[0] >= 12 && lens[0] + (lens[1] ?? 0) < 20 && !flagged.has(`2-${d}`)) {
        flagged.add(`2-${d}`);
        issues.push({ day: d, text: `Día ${d + 1}: el descanso está demasiado fragmentado; las 10 h mínimas no caben en 2 periodos.` });
      }
    }

    // Intervalo entre periodos de descanso (trabajo continuo) ≤ 14 h
    let maxCont = 0;
    let run = 0;
    let runStart = 0;
    for (let i = 0; i < SLOTS; i++) {
      if (work[i]) {
        if (run === 0) runStart = i;
        run++;
        if (run > maxCont) maxCont = run;
        if (run === 29)
          issues.push({ day: Math.floor(runStart / 48), text: `Día ${Math.floor(runStart / 48) + 1}: más de 14 h seguidas sin un periodo de descanso.` });
      } else run = 0;
    }

    // ---- Pintar resultados ----
    const badDays = new Set(issues.map((x) => x.day).filter((x) => x !== null));
    board.querySelectorAll<HTMLElement>('.hrow[data-day]').forEach((row) => {
      const d = Number(row.dataset.day);
      const w = work.slice(d * 48, d * 48 + 48).filter(Boolean).length;
      row.querySelector('[data-k="work"]')!.textContent = fmtShort(w);
      row.querySelector('[data-k="rest"]')!.textContent = fmtShort(48 - w);
      const minEl = row.querySelector<HTMLElement>('[data-k="min"]')!;
      minEl.textContent = fmtShort(dayMin[d]);
      minEl.dataset.ok = String(dayMin[d] >= 20);
      row.classList.toggle('bad', badDays.has(d));
    });

    document.getElementById('t-work')!.textContent = fmt(totalWork);
    document.getElementById('t-rest')!.textContent = fmt(totalRest);
    document.getElementById('t-min')!.textContent = fmt(globalMin);
    document.getElementById('t-cont')!.textContent = fmt(maxCont);

    const verdict = document.getElementById('verdict')!;
    const badge = document.getElementById('badge')!;
    const title = document.getElementById('verdict-title')!;
    const sub = document.getElementById('verdict-sub')!;
    verdict.dataset.state = !anyWork ? 'idle' : issues.length ? 'bad' : 'ok';
    if (!anyWork) {
      badge.textContent = '—';
      title.textContent = 'Introduce tu horario';
      sub.textContent = 'Marca las horas trabajadas o aplica una guardia tipo.';
    } else if (issues.length) {
      badge.textContent = '✕';
      title.textContent = `${issues.length} ${issues.length === 1 ? 'incumplimiento detectado' : 'incumplimientos detectados'}`;
      sub.textContent = 'Revisa los días marcados en rojo.';
    } else {
      badge.textContent = '✓';
      title.textContent = 'Cumple los mínimos de descanso';
      sub.textContent = 'El horario registrado respeta los límites del STCW y el MLC 2006.';
    }
    const list = document.getElementById('issues')!;
    list.innerHTML = '';
    issues.forEach((x) => {
      const li = document.createElement('li');
      li.textContent = x.text;
      list.appendChild(li);
    });
  }

  work.forEach((v, i) => setCell(i, v));
  update();
</script>

<style>
  .rules {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .rule {
    padding: 1.1rem 1.2rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: grid;
    gap: 0.2rem;
  }
  .rule strong {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--brass-dark);
    line-height: 1.1;
  }
  .rule span {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.45;
  }
  .toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 1rem;
  }
  .presets,
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--navy-800);
    margin-right: 0.3rem;
  }
  .chip {
    font: 500 0.85rem/1 var(--font-body);
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.2s;
  }
  .chip:hover {
    border-color: var(--navy-700);
    color: var(--navy-800);
  }
  .hint {
    font-size: 0.88rem;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.2rem;
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .sw {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid var(--line);
  }
  .sw-work {
    background: var(--navy-700);
  }
  .sw-rest {
    background: #e7eef5;
    margin-left: 0.6rem;
  }
  .board-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }
  .board {
    min-width: 920px;
    padding: 0.8rem 1rem 1rem;
    user-select: none;
    touch-action: manipulation;
  }
  .hrow {
    display: grid;
    grid-template-columns: 64px 1fr 230px;
    align-items: center;
    gap: 0.8rem;
    padding: 0.35rem 0;
    border-radius: 8px;
  }
  .hrow.bad .dlabel {
    color: var(--warn);
  }
  .hrow.bad .cells {
    box-shadow: 0 0 0 2px rgba(196, 87, 58, 0.45);
  }
  .dlabel {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--navy-800);
  }
  .cells {
    display: grid;
    grid-template-columns: repeat(48, 1fr);
    gap: 2px;
    border-radius: 6px;
  }
  .head .cells {
    grid-template-columns: repeat(24, 1fr);
  }
  .hlabel {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    text-align: left;
  }
  .cell {
    height: 34px;
    border: 0;
    padding: 0;
    background: #e7eef5;
    cursor: pointer;
    border-radius: 3px;
    transition: background-color 0.1s;
  }
  .cell:nth-child(2n) {
    margin-right: 1px;
  }
  .cell:hover {
    background: #cddbea;
  }
  .cell.on {
    background: var(--navy-700);
  }
  .cell.on:hover {
    background: var(--navy-600);
  }
  .dstats {
    white-space: nowrap;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
    text-align: center;
  }
  .head-stats {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  [data-k='min'][data-ok='true'] {
    color: var(--ok);
    font-weight: 600;
  }
  [data-k='min'][data-ok='false'] {
    color: var(--warn);
    font-weight: 600;
  }
  .results {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--navy-900);
    color: rgba(255, 255, 255, 0.8);
  }
  .summary {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 1.5rem;
    align-items: center;
  }
  .big {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .big > div {
    display: grid;
    gap: 0.2rem;
  }
  .big strong {
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.2;
  }
  .big span:not(.badge) {
    font-size: 0.9rem;
  }
  .badge {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    font-size: 1.6rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
  }
  [data-state='ok'] .badge {
    background: var(--ok);
  }
  [data-state='bad'] .badge {
    background: var(--warn);
  }
  .totals {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .totals div {
    background: var(--navy-800);
    padding: 0.9rem 1rem;
    display: grid;
    gap: 0.2rem;
  }
  .totals span {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
  }
  .totals strong {
    color: var(--brass-light);
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }
  .issues {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .issues:not(:empty) {
    margin-top: 1.25rem;
  }
  .issues li {
    padding: 0.7rem 1rem;
    border-radius: var(--radius-sm);
    background: rgba(196, 87, 58, 0.18);
    border-left: 3px solid var(--warn);
    font-size: 0.93rem;
    color: #ffd9cc;
  }
  .info {
    margin: 2rem 0 4rem;
  }
  .info :global(svg) {
    flex: none;
    color: var(--warn);
  }
  .info p {
    margin: 0;
  }
  @media (max-width: 900px) {
    .rules {
      grid-template-columns: 1fr 1fr;
    }
    .summary {
      grid-template-columns: 1fr;
    }
    .totals {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
