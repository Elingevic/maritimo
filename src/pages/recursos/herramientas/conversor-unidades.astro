---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';

// Factores respecto a la unidad base de cada magnitud
const GROUPS = [
  {
    id: 'presion',
    name: 'Presión',
    icon: 'gauge',
    base: 'bar',
    units: [
      { id: 'bar', name: 'bar', f: 1 },
      { id: 'psi', name: 'psi', f: 0.0689475729 },
      { id: 'kpa', name: 'kPa', f: 0.01 },
      { id: 'mpa', name: 'MPa', f: 10 },
      { id: 'kgcm2', name: 'kg/cm²', f: 0.980665 },
      { id: 'atm', name: 'atm', f: 1.01325 },
      { id: 'mbar', name: 'mbar', f: 0.001 },
      { id: 'mmhg', name: 'mmHg', f: 0.00133322368 },
      { id: 'mh2o', name: 'm.c.a. (mH₂O)', f: 0.0980665 },
    ],
  },
  {
    id: 'temperatura',
    name: 'Temperatura',
    icon: 'gauge',
    base: 'c',
    units: [
      { id: 'c', name: '°C', f: 0 },
      { id: 'f', name: '°F', f: 0 },
      { id: 'k', name: 'K', f: 0 },
    ],
  },
  {
    id: 'potencia',
    name: 'Potencia',
    icon: 'gauge',
    base: 'kw',
    units: [
      { id: 'kw', name: 'kW', f: 1 },
      { id: 'mw', name: 'MW', f: 1000 },
      { id: 'hp', name: 'HP (mecánico)', f: 0.745699872 },
      { id: 'cv', name: 'CV / PS (métrico)', f: 0.73549875 },
      { id: 'btuh', name: 'BTU/h', f: 0.00029307107 },
    ],
  },
  {
    id: 'volumen',
    name: 'Volumen',
    icon: 'gauge',
    base: 'm3',
    units: [
      { id: 'm3', name: 'm³', f: 1 },
      { id: 'l', name: 'litros', f: 0.001 },
      { id: 'bbl', name: 'barriles (bbl)', f: 0.158987295 },
      { id: 'galus', name: 'galones US', f: 0.003785411784 },
      { id: 'galuk', name: 'galones imperiales', f: 0.00454609 },
      { id: 'ft3', name: 'pies³', f: 0.028316846592 },
    ],
  },
  {
    id: 'caudal',
    name: 'Caudal',
    icon: 'gauge',
    base: 'm3h',
    units: [
      { id: 'm3h', name: 'm³/h', f: 1 },
      { id: 'lmin', name: 'L/min', f: 0.06 },
      { id: 'ls', name: 'L/s', f: 3.6 },
      { id: 'gpm', name: 'GPM (US)', f: 0.2271247 },
      { id: 'bblh', name: 'bbl/h', f: 0.158987295 },
    ],
  },
  {
    id: 'distancia',
    name: 'Distancia',
    icon: 'compass',
    base: 'm',
    units: [
      { id: 'nm', name: 'millas náuticas', f: 1852 },
      { id: 'cable', name: 'cables', f: 185.2 },
      { id: 'km', name: 'km', f: 1000 },
      { id: 'm', name: 'metros', f: 1 },
      { id: 'mi', name: 'millas terrestres', f: 1609.344 },
      { id: 'brazas', name: 'brazas (fathoms)', f: 1.8288 },
      { id: 'ft', name: 'pies', f: 0.3048 },
      { id: 'in', name: 'pulgadas', f: 0.0254 },
    ],
  },
  {
    id: 'velocidad',
    name: 'Velocidad',
    icon: 'compass',
    base: 'ms',
    units: [
      { id: 'kn', name: 'nudos', f: 0.514444444 },
      { id: 'kmh', name: 'km/h', f: 0.277777778 },
      { id: 'ms', name: 'm/s', f: 1 },
      { id: 'mph', name: 'mph', f: 0.44704 },
    ],
  },
  {
    id: 'masa',
    name: 'Masa',
    icon: 'anchor',
    base: 'kg',
    units: [
      { id: 't', name: 'toneladas métricas', f: 1000 },
      { id: 'kg', name: 'kg', f: 1 },
      { id: 'lb', name: 'libras', f: 0.45359237 },
      { id: 'lt', name: 'toneladas largas (UK)', f: 1016.0469088 },
      { id: 'st', name: 'toneladas cortas (US)', f: 907.18474 },
    ],
  },
  {
    id: 'par',
    name: 'Par de apriete',
    icon: 'toolbox',
    base: 'nm',
    units: [
      { id: 'nm', name: 'N·m', f: 1 },
      { id: 'kgm', name: 'kgf·m', f: 9.80665 },
      { id: 'lbft', name: 'lbf·ft', f: 1.3558179483 },
      { id: 'lbin', name: 'lbf·in', f: 0.112984829 },
    ],
  },
