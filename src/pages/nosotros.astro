---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
// Texto editable desde el panel: Ajustes → Página "Nosotros"
import { Content, frontmatter } from '../data/nosotros.md';

const titulo: string = frontmatter.titulo ?? 'Nosotros';
const datos: string[] = frontmatter.datos ?? [];
const foto: string | undefined = frontmatter.foto || undefined;
const despedida: string | undefined = frontmatter.despedida || undefined;
const icons = ['book', 'clock', 'ship', 'gauge', 'anchor', 'compass'];
const initials = SITE.author.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---
<Base
  title="Nosotros"
  description={`${titulo}. La historia de ${SITE.author} y el origen de ${SITE.name}.`}
>
  <PageHero
    kicker="Nosotros"
    title={titulo}
    icon="anchor"
    breadcrumbs={[{ href: '/nosotros/', label: 'Nosotros' }]}
  />

  <section class="section">
    <div class="container about-grid">
      <aside class="profile reveal">
        <div class="portrait" aria-hidden={foto ? undefined : 'true'}>
          {foto ? (
            <img src={foto} alt={SITE.author} width="600" height="600" />
          ) : (
          <svg viewBox="0 0 200 200">
            <defs>
              <linearGradient id="pg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#1f4675" />
                <stop offset="1" stop-color="#0a1a2f" />
              </linearGradient>
            </defs>
            <rect width="200" height="200" fill="url(#pg)" />
            <g fill="none" stroke="rgba(255,255,255,0.08)">
              <circle cx="100" cy="100" r="90" />
              <circle cx="100" cy="100" r="60" />
            </g>
            <text x="100" y="118" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-size="56" fill="#e5c07b">{initials}</text>
            <g fill="#c99a3c">
              <rect x="62" y="150" width="76" height="5" rx="1" />
              <rect x="62" y="160" width="76" height="5" rx="1" />
            </g>
          </svg>
          )}
        </div>
        <div class="profile-body">
          <strong>{SITE.author}</strong>
          <span>{SITE.authorRole}</span>
          {datos.length > 0 && (
            <ul>
              {datos.map((d, i) => <li><Icon name={icons[i % icons.length]} size={18} /> {d}</li>)}
            </ul>
          )}
          <a href={SITE.legacyBlog} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">
            Blog Ingmaritima <Icon name="external" size={14} />
          </a>
        </div>
      </aside>

      <div class="prose story reveal">
        <Content />
        {despedida && <p class="signoff">{despedida}</p>}
        <p class="signature">— {SITE.author}</p>
      </div>
    </div>
  </section>

  <section class="section-tight values-band">
    <div class="container">
      <div class="kicker">Lo que encontrarás aquí</div>
      <div class="grid grid-3">
        <div class="value reveal">
          <Icon name="checklist" size={28} />
          <h3>Herramientas operativas</h3>
          <p>Plantillas, checklists y calculadoras pensadas para usarse a bordo, no para quedarse en un cajón.</p>
        </div>
        <div class="value reveal">
          <Icon name="compass" size={28} />
          <h3>Experiencia real</h3>
          <p>Contenido escrito desde la sala de máquinas y la cubierta, con lo que funciona en el día a día.</p>
        </div>
        <div class="value reveal">
          <Icon name="language" size={28} />
          <h3>Inglés y carrera</h3>
          <p>Vocabulario técnico, comunicación a bordo y claves para crecer profesionalmente por mérito propio.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container cta-row">
      <h2>¿Tienes una duda o quieres proponer un tema?</h2>
      <a href="/contacto/" class="btn btn-brass"><Icon name="mail" /> Escríbeme</a>
    </div>
  </section>
</Base>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .profile {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .portrait svg {
    width: 100%;
    height: auto;
  }
  .profile-body {
    padding: 1.4rem;
    display: grid;
    gap: 0.2rem;
  }
  .profile-body > strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--navy-900);
  }
  .profile-body > span {
    color: var(--brass-dark);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .profile ul {
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 1.3rem;
    display: grid;
    gap: 0.6rem;
    font-size: 0.93rem;
    color: var(--ink-soft);
  }
  .profile li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .profile li :global(svg) {
    color: var(--ocean);
  }
  .profile .btn {
    justify-self: start;
  }
  .story {
    font-size: 1.15rem;
  }
  .story > :global(p:first-child::first-letter) {
    float: left;
    font-family: var(--font-display);
    font-size: 4.2rem;
    line-height: 0.85;
    padding: 0.35rem 0.6rem 0 0;
    color: var(--brass-dark);
  }
  .story :global(blockquote) {
    font-size: 1.25rem;
    font-family: var(--font-display);
  }
  .signoff {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--navy-800);
  }
  .signature {
    color: var(--muted);
  }
  .values-band {
    background: var(--sand-100);
    border-block: 1px solid var(--line);
  }
  .value {
    padding: 1.8rem;
    background: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
  }
  .value :global(svg) {
    color: var(--brass-dark);
    margin-bottom: 1rem;
  }
  .value p {
    color: var(--muted);
    margin: 0;
  }
  .cta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-bottom: 5rem;
  }
  .cta-row h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
  }
  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .profile {
      position: static;
      max-width: 420px;
    }
  }
</style>
