---
interface Props {
  size?: number;
  light?: boolean;
  showText?: boolean;
}
const { size = 40, light = false, showText = true } = Astro.props;
---
<span class:list={['logo', { 'logo-light': light }]}>
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
    <circle cx="32" cy="32" r="29" fill="none" stroke="currentColor" stroke-width="2" opacity="0.35" />
    <circle cx="32" cy="32" r="22" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.6" />
    <g stroke="currentColor" stroke-width="1.5" opacity="0.6">
      <path d="M32 3v6M32 55v6M3 32h6M55 32h6" />
    </g>
    <path d="M32 8 L37 32 L32 56 L27 32 Z" fill="var(--brass)" />
    <path d="M32 8 L37 32 L27 32 Z" fill="var(--brass-light)" />
    <path d="M8 32 L32 28 L56 32 L32 36 Z" fill="currentColor" opacity="0.85" />
    <circle cx="32" cy="32" r="3" fill="var(--navy-900)" stroke="var(--brass)" stroke-width="1.5" />
  </svg>
  {showText && (
    <span class="logo-text">
      <span class="logo-name">Rumbo <em>Mercante</em></span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--navy-800);
  }
  .logo-light {
    color: var(--white);
  }
  .logo-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .logo-name em {
    font-style: italic;
    font-weight: 400;
    color: var(--brass-dark);
  }
  .logo-light .logo-name em {
    color: var(--brass-light);
  }
</style>
