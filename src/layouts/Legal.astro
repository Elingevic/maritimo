---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}
const { title, description, path, updated } = Astro.props;
---
<Base title={title} description={description}>
  <PageHero kicker="Información legal" title={title} icon="shield" breadcrumbs={[{ href: path, label: title }]}>
    <p class="updated">Última actualización: {updated}</p>
  </PageHero>
  <section class="section">
    <div class="container-narrow prose legal">
      <slot />
    </div>
  </section>
</Base>

<style>
  .updated {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.55);
  }
  .legal {
    padding-bottom: 3rem;
  }
</style>
